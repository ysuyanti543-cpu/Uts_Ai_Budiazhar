"""Pelatihan, evaluasi, dan penyimpanan model Kasus 8."""
from pathlib import Path

import joblib
import numpy as np
import pandas as pd
from sklearn.compose import ColumnTransformer
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (average_precision_score, confusion_matrix, f1_score,
                             precision_score, recall_score, roc_auc_score,
                             accuracy_score, balanced_accuracy_score)
from sklearn.model_selection import GroupShuffleSplit, StratifiedGroupKFold, cross_validate
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import FunctionTransformer, StandardScaler

from fitur import (FITUR_BINER, FITUR_NUMERIK, KOLOM_BUANG, KOLOM_MENTAH,
                   URUTAN_EDUCATION, tambah_fitur)

SEED = 42
BASE = Path(__file__).resolve().parent
DATA = BASE / "dataset" / "kasus08_infert.csv"
OUT = BASE / "models" / "infert_model.joblib"


def audit(df):
    return {
        "jumlah_baris": int(len(df)),
        "missing_total": int(df.isna().sum().sum()),
        "duplikat_semua_kolom": int(df.duplicated().sum()),
        "duplikat_tanpa_stratum": int(df.drop(columns=["stratum", "pooled.stratum"]).duplicated().sum()),
        "proporsi_kasus": float(df["case"].mean()),
        "nilai_negatif": int((df.select_dtypes("number") < 0).sum().sum()),
    }


def buat_pipeline(model):
    prep = ColumnTransformer([("num", StandardScaler(), FITUR_NUMERIK),
                              ("bin", "passthrough", FITUR_BINER)])
    return Pipeline([("fitur", FunctionTransformer(tambah_fitur)),
                     ("prep", prep), ("model", model)])


def hitung_metrik(y_true, proba, ambang=0.5):
    pred = (proba >= ambang).astype(int)
    tn, fp, fn, tp = confusion_matrix(y_true, pred).ravel()
    return {
        "roc_auc": roc_auc_score(y_true, proba),
        "pr_auc": average_precision_score(y_true, proba),
        "accuracy": accuracy_score(y_true, pred),
        "balanced_accuracy": balanced_accuracy_score(y_true, pred),
        "precision": precision_score(y_true, pred, zero_division=0),
        "recall": recall_score(y_true, pred),
        "f1": f1_score(y_true, pred),
        "confusion_matrix": [[int(tn), int(fp)], [int(fn), int(tp)]],
        "ambang": ambang,
    }


def main():
    df = pd.read_csv(DATA)
    info_audit = audit(df)
    print("Audit:", info_audit)

    y = df["case"]
    groups = df["stratum"]                      # hanya untuk split/CV, bukan fitur
    X = df.drop(columns=KOLOM_BUANG)[KOLOM_MENTAH]

    # 1) SPLIT dulu (per stratum), sebelum scaling/encoding apa pun
    idx_tr, idx_te = next(GroupShuffleSplit(n_splits=1, test_size=0.2,
                                            random_state=SEED).split(X, y, groups))
    X_tr, X_te = X.iloc[idx_tr], X.iloc[idx_te]
    y_tr, y_te = y.iloc[idx_tr], y.iloc[idx_te]
    g_tr = groups.iloc[idx_tr]
    print(f"Train={len(X_tr)} (kasus {y_tr.mean():.2%}) | Test={len(X_te)} (kasus {y_te.mean():.2%})")

    kandidat = {
        "Logistic Regression": LogisticRegression(class_weight="balanced", max_iter=1000,
                                                  random_state=SEED),
        "Random Forest": RandomForestClassifier(n_estimators=300, max_depth=4, min_samples_leaf=5,
                                                class_weight="balanced_subsample",
                                                random_state=SEED, n_jobs=-1),
    }

    # 2) Pemilihan model: CV di data train saja
    cv = StratifiedGroupKFold(n_splits=5, shuffle=True, random_state=SEED)
    skor = ["roc_auc", "average_precision", "f1", "recall", "precision"]
    baris = []
    for nama, model in kandidat.items():
        hasil = cross_validate(buat_pipeline(model), X_tr, y_tr, groups=g_tr,
                               cv=cv, scoring=skor, n_jobs=1)
        baris.append({"model": nama, **{s: float(np.mean(hasil[f"test_{s}"])) for s in skor},
                      "roc_auc_std": float(np.std(hasil["test_roc_auc"]))})
    tabel_cv = pd.DataFrame(baris).sort_values("roc_auc", ascending=False).reset_index(drop=True)
    print("\nHasil CV (data train):\n", tabel_cv.round(3).to_string(index=False))

    terbaik = tabel_cv.loc[0, "model"]
    print("\nModel terpilih:", terbaik)

    # 3) Fit ke seluruh train, evaluasi di test SATU kali
    pipe = buat_pipeline(kandidat[terbaik]).fit(X_tr, y_tr)
    proba_te = pipe.predict_proba(X_te)[:, 1]
    metrik_test = hitung_metrik(y_te.to_numpy(), proba_te)
    print("\nMetrik test:", {k: (round(v, 3) if isinstance(v, float) else v)
                              for k, v in metrik_test.items()})

    # 4) Simpan pipeline + metadata
    OUT.parent.mkdir(exist_ok=True)
    mdl = pipe.named_steps["model"]
    joblib.dump({
        "pipeline": pipe,
        "model_terpilih": terbaik,
        "kolom_input": KOLOM_MENTAH,
        "opsi_education": URUTAN_EDUCATION,
        "kelas": {0: "Kontrol", 1: "Kasus"},
        "metrik_test": metrik_test,
        "tabel_cv": tabel_cv.to_dict("records"),
        "audit": info_audit,
        "rentang": {c: [int(X[c].min()), int(X[c].max())]
                    for c in ["age", "parity", "induced", "spontaneous"]},
        "ukuran": {"train": int(len(X_tr)), "test": int(len(X_te))},
        "y_test": y_te.tolist(),
        "proba_test": [float(p) for p in proba_te],
        "koefisien": ({n: float(c) for n, c in zip(FITUR_NUMERIK + FITUR_BINER, mdl.coef_[0])}
                      if hasattr(mdl, "coef_") else None),
    }, OUT)
    print("Model disimpan ke", OUT.relative_to(BASE))


if __name__ == "__main__":
    main()
