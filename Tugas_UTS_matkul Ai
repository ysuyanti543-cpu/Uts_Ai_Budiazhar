"""Aplikasi Streamlit Kasus 8: prediksi kelompok kasus pada studi infertilitas."""
from pathlib import Path

import joblib
import pandas as pd
import streamlit as st

import fitur  # noqa: F401  (agar joblib dapat memuat FunctionTransformer)

MODEL_PATH = Path(__file__).resolve().parent / "models" / "infert_model.joblib"

st.set_page_config(page_title="Prediksi Studi Infertilitas", page_icon="🩺", layout="centered")


@st.cache_resource
def muat_model():
    return joblib.load(MODEL_PATH)


if not MODEL_PATH.exists():
    st.error("Model belum ada. Jalankan `python latih.py` terlebih dahulu.")
    st.stop()

paket = muat_model()
pipe = paket["pipeline"]
rng = paket["rentang"]
ambang = paket["metrik_test"]["ambang"]

st.title("🩺 Prediksi Kelompok Kasus")
st.subheader("Studi kasus-kontrol infertilitas")
st.info(
    "**Cara pakai:** isi lima data di tab *Prediksi*, lalu tekan **Hitung prediksi**. "
    "Aplikasi menampilkan prediksi (Kasus/Kontrol) beserta probabilitasnya.\n\n"
    "Aplikasi ini untuk **pembelajaran**, bukan alat diagnosis medis."
)

tab_pred, tab_metrik, tab_info = st.tabs(["🔮 Prediksi", "📊 Metrik evaluasi", "ℹ️ Tentang model"])

# ---------------------------------------------------------------- PREDIKSI
with tab_pred:
    with st.form("form_prediksi"):
        st.markdown("#### Data perempuan yang diperiksa")
        c1, c2 = st.columns(2)
        with c1:
            education = st.selectbox("Lama pendidikan", paket["opsi_education"], index=1,
                                     help="0-5 tahun, 6-11 tahun, atau 12 tahun ke atas")
            age = st.number_input("Usia (tahun)", min_value=15, max_value=60, value=30)
            parity = st.number_input("Parity (jumlah kehamilan yang dilahirkan)",
                                     min_value=0, max_value=10, value=2)
        with c2:
            induced = st.number_input("Aborsi induksi (kali)", min_value=0, max_value=10, value=0,
                                      help="Jumlah kehamilan yang diakhiri dengan tindakan medis")
            spontaneous = st.number_input("Keguguran spontan (kali)", min_value=0, max_value=10, value=0,
                                          help="Jumlah kehamilan yang berakhir keguguran tanpa tindakan")
        kirim = st.form_submit_button("Hitung prediksi", type="primary")

    if kirim:
        mentah = pd.DataFrame([{"education": education, "age": age, "parity": parity,
                                "induced": induced, "spontaneous": spontaneous}])[paket["kolom_input"]]

        for kol, (lo, hi) in rng.items():
            if not lo <= mentah.loc[0, kol] <= hi:
                st.warning(f"Nilai **{kol}** ({mentah.loc[0, kol]}) di luar rentang data latih "
                           f"({lo}–{hi}); hasil kurang dapat diandalkan.")

        proba = pipe.predict_proba(mentah)[0]          # [P(kontrol), P(kasus)]
        kelas = int(proba[1] >= ambang)

        st.markdown("### Hasil prediksi")
        if kelas == 1:
            st.warning(f"**Prediksi: KASUS** — model memperkirakan peluang kelompok kasus "
                       f"sebesar **{proba[1]:.1%}**.")
        else:
            st.success(f"**Prediksi: KONTROL** — model memperkirakan peluang kelompok kasus "
                       f"hanya **{proba[1]:.1%}**.")

        m1, m2 = st.columns(2)
        m1.metric("Probabilitas Kasus", f"{proba[1]:.1%}")
        m2.metric("Probabilitas Kontrol", f"{proba[0]:.1%}")
        st.progress(float(proba[1]), text=f"Peluang kasus: {proba[1]:.1%} (ambang keputusan {ambang:.0%})")

        st.markdown("#### Bagaimana jika jumlah keguguran spontan berbeda?")
        st.caption("Data lain tetap sama; hanya keguguran spontan yang diubah.")
        skenario = []
        for s in range(rng["spontaneous"][0], rng["spontaneous"][1] + 1):
            x = mentah.copy(); x["spontaneous"] = s
            skenario.append({"Keguguran spontan": s,
                             "Peluang kasus": f"{pipe.predict_proba(x)[0][1]:.1%}"})
        st.table(pd.DataFrame(skenario).set_index("Keguguran spontan"))

        with st.expander("Lihat fitur turunan yang dihitung otomatis"):
            st.dataframe(fitur.tambah_fitur(mentah))

# ----------------------------------------------------------------- METRIK
with tab_metrik:
    m = paket["metrik_test"]
    st.markdown("#### Hasil pada data uji (dievaluasi satu kali)")
    a, b, c = st.columns(3)
    a.metric("ROC-AUC", f"{m['roc_auc']:.3f}")
    b.metric("PR-AUC", f"{m['pr_auc']:.3f}")
    c.metric("Akurasi", f"{m['accuracy']:.3f}")
    d, e, f = st.columns(3)
    d.metric("Recall (Kasus)", f"{m['recall']:.3f}")
    e.metric("Precision (Kasus)", f"{m['precision']:.3f}")
    f.metric("F1 (Kasus)", f"{m['f1']:.3f}")

    st.markdown("**Arti metrik**")
    st.markdown(
        "- **ROC-AUC**: kemampuan membedakan kasus dari kontrol (0,5 = tebakan acak, 1 = sempurna).\n"
        "- **PR-AUC**: ringkasan precision-recall; lebih peka pada kelas kasus yang lebih sedikit.\n"
        "- **Recall**: dari semua kasus sebenarnya, berapa yang berhasil terdeteksi.\n"
        "- **Precision**: dari semua yang diprediksi kasus, berapa yang benar.\n"
        "- **F1**: rata-rata harmonik precision dan recall.\n"
        "- **Akurasi**: hanya pelengkap, karena kelas tidak seimbang."
    )

    tn, fp = m["confusion_matrix"][0]
    fn, tp = m["confusion_matrix"][1]
    st.markdown("#### Confusion matrix")
    st.dataframe(pd.DataFrame([[tn, fp], [fn, tp]],
                              index=["Aktual: Kontrol", "Aktual: Kasus"],
                              columns=["Prediksi: Kontrol", "Prediksi: Kasus"]))
    st.caption(f"Dari {tp + fn} kasus sebenarnya, {tp} terdeteksi dan {fn} terlewat. "
               f"Dari {tn + fp} kontrol sebenarnya, {fp} salah diprediksi sebagai kasus.")

    st.markdown("#### Perbandingan model (cross-validation di data latih)")
    st.dataframe(pd.DataFrame(paket["tabel_cv"]).round(3).set_index("model"))
    st.caption(f"Model terpilih: **{paket['model_terpilih']}**. Data latih {paket['ukuran']['train']} baris, "
               f"data uji {paket['ukuran']['test']} baris. Data uji kecil, sehingga angka dapat berfluktuasi; "
               "angka cross-validation lebih stabil.")

# ------------------------------------------------------------------ INFO
with tab_info:
    st.markdown("#### Tentang model")
    st.markdown(
        f"- **Algoritma terpilih:** {paket['model_terpilih']} (dalam pipeline scikit-learn)\n"
        "- **Target:** `case` (1 = kasus, 0 = kontrol)\n"
        "- **Input mentah:** pendidikan, usia, parity, aborsi induksi, keguguran spontan\n"
        "- **Fitur turunan otomatis:** total kehilangan kehamilan, total kehamilan, "
        "indikator pernah keguguran spontan, indikator pernah aborsi induksi, "
        "dan pendidikan dalam bentuk ordinal\n"
        "- **Kolom dibuang:** `stratum` dan `pooled.stratum` (nomor kelompok pencocokan dari desain "
        "studi, tidak ada pada data baru)"
    )
    st.markdown("#### Keterbatasan")
    st.markdown(
        "- Studi kasus-kontrol hanya menunjukkan **asosiasi**, bukan sebab-akibat.\n"
        "- Usia, parity, dan pendidikan dicocokkan oleh desain studi, sehingga sinyal utama "
        "berasal dari riwayat keguguran spontan.\n"
        "- Data hanya 248 baris; hasil tidak boleh dipakai untuk keputusan medis."
    )
    with st.expander("Ringkasan audit data"):
        st.json(paket["audit"])


